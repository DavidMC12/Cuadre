# Cadena de conexion a PostgreSQL (Neon).
# Copia este archivo como .env y pega tu cadena real ahi.
# El .env NUNCA se sube a Git.
DATABASE_URL="postgresql://usuario:clave@host.neon.tech/cuadre?sslmode=require"

# Entorno de ejecucion: development | test | production
NODE_ENV="development"

# Puerto de la API.
PORT="3001"

# Sitios que pueden llamar a la API, separados por comas. Nunca "*".
CORS_ORIGINS="http://localhost:3000"

# --- Autenticacion (Neon Auth / Better Auth administrado) ------------------
# Se activan en el panel de Neon: Auth -> Enable Auth. Ahi mismo sale la URL.
#
# La direccion lleva en medio el servidor intermedio del proyecto (el tramo
# "c-N"), que sale del host de tu DATABASE_URL. Si el host es
# "ep-algo-pooler.c-4.us-west-2.aws.neon.tech", la de auth es
# "https://ep-algo.neonauth.c-4.us-west-2.aws.neon.tech/neondb/auth": sin el
# "-pooler", con "neonauth" agregado. Si falta ese tramo, entrar falla con un
# error 500 que no explica nada.
#
# El secreto se genera una vez con: openssl rand -base64 32
NEON_AUTH_BASE_URL="https://ep-xxxxxxxx.neonauth.c-N.us-west-2.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET=""

# --- Solo para las pruebas de integracion ---------------------------------
# Con estas dos, cada tanda de pruebas crea una copia desechable de la base y
# la borra al terminar. Sin ellas las pruebas corren igual, pero contra
# DATABASE_URL y dejando datos que no se pueden limpiar.
# La clave sale del panel de Neon: Account settings -> API keys.
NEON_API_KEY=""
NEON_PROJECT_ID=""
