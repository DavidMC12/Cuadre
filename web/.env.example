# Copia este archivo como .env.local y pega los valores reales ahi.
# El .env.local NUNCA se sube a Git.
#
# Los dos valores de abajo son los mismos que ya estan en el .env de la raiz
# del repo (los usa tambien la API en src/). Next.js solo lee archivos .env
# dentro de esta carpeta (web/), por eso hay que copiarlos aqui tambien.

# Direccion del servicio de autenticacion (Neon Auth / Better Auth).
# Ojo con el tramo "c-N" en medio: ver la nota en el .env.example de la raiz.
NEON_AUTH_BASE_URL="https://ep-xxxxxxxx.neonauth.c-N.us-west-2.aws.neon.tech/neondb/auth"

# Secreto para firmar la cookie de sesion. Minimo 32 caracteres.
NEON_AUTH_COOKIE_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL base de la API de Fastify. En produccion, con pantallas y API en la
# misma direccion de Vercel, no hace falta: las peticiones van a rutas
# relativas. Solo se usa en desarrollo local, cuando la API corre aparte.
NEXT_PUBLIC_API_URL="http://localhost:3001"
